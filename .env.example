# InterviewOS settings. Copy this file to `.env` in the repo root:   cp .env.example .env
# `.env` is gitignored: your keys never leave your PC. Never commit it, never paste keys into issues or chats.
#
# Running on your own PC? Nothing below is required:
#   * With no keys, the backend uses a scripted fake AI, so every screen works offline (APP_ENV=local).
#   * For the real experience, fill in only these (both have free tiers):
#       GROQ_API_KEY  VERA, the evaluators, reports and ARIA's replies   https://console.groq.com/keys
#       HF_TOKEN      ARIA's search over your reports (a "Read" token)    https://huggingface.co/settings/tokens
#   * Coding interviews need a code runner you host yourself: see "Code execution" below. Leave PISTON_URL empty
#     and the Coding option simply stays hidden.
#   * USE_INMEMORY_DB=true needs no database (data resets on restart); or run MongoDB (docker compose) instead.
#
# Deploying? Set APP_ENV=prod and a JWT_SECRET of 32+ characters, and put secrets in your host's secret store
# (environment variables / a key vault), not in a file in the image. See docs/deployment.md.

# ── App ─────────────────────────────────────────────
APP_ENV=local                       # local | test | dev | prod
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# ── Auth ────────────────────────────────────────────
JWT_SECRET=                         # required (>= 32 chars) in dev/prod; e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# ── Database (Cosmos DB MongoDB API; plain MongoDB locally) ──
COSMOS_CONNECTION_STRING=mongodb://localhost:27017
COSMOS_DATABASE=interview_coach
USE_INMEMORY_DB=false               # true = no MongoDB needed (local only; data resets on restart, auto-seeded)
SEED_ON_STARTUP=false               # true = load the question bank + companies at boot (hosts with no shell, e.g. Render free)
AZURE_BLOB_CONNECTION_STRING=

# ── AI Gateway: every LLM call runs on Groq ─────────
# One key for the interviewer, evaluators, reports and the Mentor.
GROQ_API_KEY=
GROQ_INTERVIEW_MODEL=openai/gpt-oss-120b   # interviewer agent, report generator
GROQ_FAST_MODEL=openai/gpt-oss-20b         # answer evaluation, high-volume calls
SESSION_TOKEN_BUDGET=60000
# Interview work (evaluation, report) older than this is presumed abandoned and taken over on reconnect
STALE_WORK_SECONDS=120
# One follow-up after a partial answer (set false to save tokens)
INTERVIEW_FOLLOW_UPS=true
# The interviewer agent (Groq gpt-oss-120b) writes the dialogue and proposes each move; false = plain wording
INTERVIEW_AGENT=true
# Groq writes the report's words (scores are always computed); false = the report stitched from the evaluator's notes
REPORT_WRITER=true
# USE_FAKE_GATEWAY=                 # unset = fake in local/test, real elsewhere

# ── Mentor RAG (rag_tool) ───────────────────────────
# HF_TOKEN is for embeddings only (Groq has no embedding models). Without it the Mentor is
# disabled and the app still runs. Mentor chat uses GROQ_API_KEY above.
HF_TOKEN=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHAT_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b             # Mentor chat model
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=interview_reports_v2

# ── Code execution (your own Piston) ────────────
# Coding interviews run candidates' code on Piston (github.com/engineer-man/piston), a sandboxed code runner you
# host yourself. There is no shared runner: leave PISTON_URL empty and coding interviews are simply hidden.
# Local, with Docker (Piston needs a privileged container, so Linux or Docker Desktop):
#   docker run --privileged -d -p 2000:2000 -v piston-data:/piston --name piston ghcr.io/engineer-man/piston
#   curl http://localhost:2000/api/v2/packages          # list available runtimes, then install Python (graded):
#   curl -X POST http://localhost:2000/api/v2/packages -H "Content-Type: application/json" -d '{"language":"python","version":"3.12.0"}'
#   (optional, ungraded: node, java, gcc for C/C++)
# then set PISTON_URL=http://localhost:2000/api/v2. A proxy in front of Piston that serves POST <url>/execute also
# works; PISTON_API_KEY is sent to it as X-API-Key. Never expose a Piston without a key or a firewall.
PISTON_URL=
PISTON_API_KEY=
PISTON_TIMEOUT_S=30
CODE_RUNS_PER_MINUTE=12                     # "Run" presses per candidate
MAX_INTERVIEW_MINUTES=60                    # wrap up after this long, whatever the question count

# ── Abuse limits (per process) ──────────────────────
LOGIN_FAILURES_PER_15_MIN=10                # per email (x3 per IP)
REGISTRATIONS_PER_HOUR=20                   # per IP
MENTOR_MESSAGES_PER_MINUTE=10               # per candidate
INTERVIEWS_PER_HOUR=20                      # per candidate
PREP_PLANS_PER_HOUR=5                       # per candidate (company research + JD + plan)
MAX_REQUEST_BYTES=1000000

# ── Voice (Azure AI Speech) ─────────────────────────
SPEECH_KEY=
SPEECH_REGION=

# ── Observability & cost (Phase 6) ──────────────────
ADMIN_EMAILS=[]                             # e.g. ["you@example.com"]: can open /admin and change prompt versions
DAILY_TOKEN_LIMIT_PER_USER=400000           # per candidate per UTC day (0 = no limit)
GROQ_PRICE_DEFAULT_IN=0.15                  # estimated USD per 1M tokens, for the cost report: check Groq's pricing
GROQ_PRICE_DEFAULT_OUT=0.75
GROQ_PRICE_FAST_IN=0.10
GROQ_PRICE_FAST_OUT=0.50
LLM_TRACE_CONTENT=false                     # store prompts and outputs in llm_calls (debugging; they contain answers)
APPLICATIONINSIGHTS_CONNECTION_STRING=      # Azure: export traces/metrics/logs (pip install azure-monitor-opentelemetry)

# ── Refresh-token cookie (web app) ──────────────────
REFRESH_COOKIE_SAMESITE=lax                 # "none" if the frontend and API are on different sites

# ── One-server deployment (deploy/vps/docker-compose.yml only) ──
# Your two domain names; their DNS A records must point at the server. Caddy gets HTTPS certificates for both.
# APP_DOMAIN=app.example.com
# API_DOMAIN=api.example.com
